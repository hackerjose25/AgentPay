# Loaded after the runtime .env by scripts/ens-setup.ts. ENS_RPC_URL and
# ENS_CHAIN_ID are inherited from .env. Never copy this key into runtime config.
ENS_SETUP_PROVIDER_NAME=alpha.ocr.YOUR_OWNED_PARENT.eth
ENS_SETUP_OWNER_PRIVATE_KEY=0xREPLACE_WITH_DEDICATED_SEPOLIA_KEY
ENS_SETUP_ENDPOINT=https://YOUR_PROVIDER_HOST/providers/alpha
ENS_SETUP_RECIPIENT=0.0.REPLACE_ME
